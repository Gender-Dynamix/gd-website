---
import BaseLayout from '../layouts/BaseLayout.astro';
import WaveDivider from '../components/WaveDivider.astro';
import '../styles/contact.css';
---

<BaseLayout
  title="Contact Us | Gender Dynamix Aotearoa"
  description="Get in touch with our Tauranga Office for general inquiries, professional training, or questions about our services"
  ogTitle="Contact Us | Gender Dynamix Aotearoa"
  ogDescription="Contact information for gender-diverse support services in the Bay of Plenty."
>
  <div class="logo-divider" aria-hidden="true">
    <div class="divider-line"></div>
    <div class="divider-logo">
      <img src="/images/favicon.ico" alt="" />
    </div>
    <div class="divider-line"></div>
  </div>

  <section class="contact-info" id="contact-info">
    <div class="contact-info-container">
      <div class="info-card">
        <h3>Contact Info</h3>
        <div class="info-content">
          <p class="contact-item">
            <i class="fas fa-map-marker-alt" aria-hidden="true"></i>
            <span>
              <strong>Gender Dynamix of <span lang="mi">Aotearoa</span></strong
              ><br />
              Building 55, Historic Village <br />
              17th Avenue, Tauranga
            </span>
          </p>

          <p class="contact-item">
            <i class="fas fa-phone" aria-hidden="true"></i>
            <a href="tel:075482972">07 548 2972</a>
          </p>

          <p class="contact-item">
            <i class="fas fa-envelope" aria-hidden="true"></i>
            <a
              href="#"
              class="email-link"
              data-user="referrals"
              data-domain="gdnz.org">Email Us</a
            >
          </p>

          <div class="social-icons-contact">
            <a
              href="https://www.instagram.com/genderdynamixnz/"
              target="_blank"
              rel="noopener noreferrer"
              aria-label="Instagram"
            >
              <i class="fab fa-instagram" aria-hidden="true"></i>
            </a>
            <a
              href="https://www.facebook.com/genderdynamixnz/"
              target="_blank"
              rel="noopener noreferrer"
              aria-label="Facebook"
              ><i class="fab fa-facebook-f" aria-hidden="true"></i></a
            >
            <a
              href="#"
              class="email-link"
              data-user="referrals"
              data-domain="gdnz.org"
              aria-label="Email"
            >
              <i class="fas fa-envelope" aria-hidden="true"></i>
            </a>
          </div>
        </div>
      </div>

      <div class="info-card">
        <h3>Office Hours</h3>
        <div class="info-content">
          <p><strong>11:00am — 5:00pm Mon-Fri</strong></p>
          <p>Closed: Saturday-Sunday</p>
          <p class="hours-note">
            We're closed on all national and public holidays. For urgent matters
            outside our hours, please email and we'll respond as soon as
            possible.
          </p>
        </div>
      </div>

      <div class="location-card">
        <div class="location-header">
          <div class="location-icon">
            <i class="fas fa-map-marker-alt" aria-hidden="true"></i>
          </div>
          <h3>Location</h3>
        </div>
        <div class="map-container">
          <div class="map-embed">
            <iframe
              src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3156.6481250046245!2d176.14620917730463!3d-37.70446207200315!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x6d6dda4a159ecd97%3A0xa548d89a6ea2c131!2sThe%20Historic%20Village!5e0!3m2!1sen!2snz!4v1770680270680!5m2!1sen!2snz"
              width="600"
              height="450"
              style="border: 0"
              allowfullscreen=""
              loading="lazy"
              referrerpolicy="no-referrer-when-downgrade"
              title="Gender Dynamix office location at The Historic Village, Tauranga"
            ></iframe>
          </div>
        </div>

        <div class="detailed-map-card">
          <h4>Finding building 55</h4>
          <p>
            We're located in Building 55 within the Historic Village. Use this
            map to find us once you arrive:
          </p>
          <img
            src="/images/map.jpg"
            alt="Map displaying location of Building 55 within the historic village"
          />
          <div class="map-note">
            <p>
              <i class="fas fa-parking" aria-hidden="true"></i>
              <strong>Parking:</strong> Free parking available on Seventeenth Avenue.
            </p>
            <p>
              <i class="fas fa-walking" aria-hidden="true"></i>
              <strong>Access:</strong> Enter via pedestrian walkway near main entrance.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>
  <script src="../scripts/form-handler.ts"></script>
</BaseLayout>

<script is:inline>
  (function () {
    function toggleAccordion(header) {
      var content = header.nextElementSibling;
      var icon = header.querySelector('.accordion-toggle i');
      content.classList.toggle('collapsed');
      if (content.classList.contains('collapsed')) {
        icon.classList.replace('fa-arrow-up', 'fa-arrow-down');
        header
          .querySelector('.accordion-toggle')
          .setAttribute('aria-expanded', 'false');
      } else {
        icon.classList.replace('fa-arrow-down', 'fa-arrow-up');
        header
          .querySelector('.accordion-toggle')
          .setAttribute('aria-expanded', 'true');
      }
    }

    var accordionHeaders = document.querySelectorAll('.js-accordion-header');
    accordionHeaders.forEach(function (header) {
      header.addEventListener('click', function () {
        toggleAccordion(header);
      });
      header.style.cursor = 'pointer';
    });
  })();
</script>

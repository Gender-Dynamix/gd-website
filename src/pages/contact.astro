---
import BaseLayout from '../layouts/BaseLayout.astro';
import WaveDivider from '../components/WaveDivider.astro';
import '../styles/contact.css';
---

<BaseLayout
  title="Contact Us | Gender Dynamix Aotearoa"
  description="Get in touch with our Tauranga Office for general inquiries, professional training, or questions about our services"
  ogTitle="Contact Us | Gender Dynamix Aotearoa"
  ogDescription="Contact information for gender-diverse support services in the Bay of Plenty."
>
  <section class="hero">
    <div class="hero-bg-container">
      <img src="/images/hero-pattern-bg.webp" alt="" class="hero-bg-img" />
    </div>
    <div class="hero-content">
      <h1>Get in touch with us</h1>
      <p>
        We're here to listen and support you. Reach out for services or any
        questions about our work with the transgender and gender diverse
        community.
      </p>
    </div>
    <WaveDivider
      direction="down"
      fillVar="--wave-top-color"
      className="custom-shape-divider-top"
    />
  </section>

  <section class="contact-nav">
    <div class="contact-nav-container">
      <h2>How can we help you?</h2>
      <div class="contact-nav-grid">
        <a href="#general-contact" class="contact-nav-btn">
          <div class="contact-icon" aria-hidden="true">
            <i class="fas fa-envelope"></i>
          </div>
          <h3>General Inquiry</h3>
          <p>Questions about our services</p>
        </a>

        <a href="#contact-info" class="contact-nav-btn">
          <div class="contact-icon" aria-hidden="true">
            <i class="fas fa-map-marker-alt"></i>
          </div>
          <h3>Visit Us</h3>
          <p>Location, office hours and contact info</p>
        </a>
      </div>
    </div>
  </section>

  <WaveDivider direction="up" />

  <section class="form-card-section" id="general-contact">
    <div class="form-card-container">
      <div class="form-card-header js-accordion-header">
        <div class="form-title-group">
          <div class="form-icon" aria-hidden="true">
            <i class="fas fa-envelope"></i>
          </div>
          <h2>General Inquiry</h2>
        </div>
        <button
          class="form-collapse-btn accordion-toggle"
          aria-label="Toggle form"
          aria-expanded="true"
          aria-controls="generalInquiryFormContainer"
        >
          <i class="fas fa-arrow-up" aria-hidden="true"></i>
        </button>
      </div>

      <div class="form-content">
        <p class="form-description">
          Have a question about our services or want to learn more about our
          work? Send us a message and we'll get back to you as soon as possible.
        </p>

        <form data-form-type="general-inquiry" novalidate id="gi-form">
          <input type="hidden" name="form-type" value="general-inquiry" />
          <div class="visually-hidden" aria-hidden="true">
            <input
              type="text"
              name="website"
              tabindex="-1"
              autocomplete="off"
            />
          </div>
          <div class="form-row">
            <div class="form-group">
              <label for="gi-first-name">First Name:*</label>
              <input
                type="text"
                id="gi-first-name"
                name="first-name"
                required
                aria-describedby="gi-fname-error"
              />
              <span id="gi-fname-error" class="validation-message"
                >Please provide a first name so we know who we're speaking with.</span
              >
            </div>
            <div class="form-group">
              <label for="gi-last-name">Last Name:*</label>
              <input
                type="text"
                id="gi-last-name"
                name="last-name"
                required
                aria-describedby="gi-lname-error"
              />
              <span id="gi-lname-error" class="validation-message"
                >Please provide a last name to help us organize our records.</span
              >
            </div>
          </div>

          <div class="form-group">
            <label for="gi-email">Email:*</label>
            <input
              type="email"
              id="gi-email"
              name="email"
              required
              aria-describedby="gi-email-error"
            />
            <span id="gi-email-error" class="validation-message"
              >Please enter a valid email so we can send a reply</span
            >
          </div>

          <div class="form-group">
            <label for="subject">Subject:*</label>
            <select
              id="subject"
              name="subject"
              required
              aria-describedby="gi-subject-error"
            >
              <option value="">Select a topic...</option>
              <option value="general">General Question</option>
              <option value="training">Professional Training</option>
              <option value="events">Events & Groups</option>
              <option value="other">Other</option>
            </select>
            <span id="gi-subject-error" class="validation-message"
              >Please select a topic so the right person can get back to you.</span
            >
          </div>

          <div class="form-group">
            <label for="message">Message:*</label>
            <textarea
              id="message"
              name="message"
              placeholder="How can we help you today?"
              required
              aria-describedby="gi-msg-error"></textarea>
            <span id="gi-msg-error" class="validation-message"
              >Please let us know how we can help you today.</span
            >
          </div>

          <div class="turnstile-container">
            <div
              class="cf-turnstile"
              data-sitekey={import.meta.env.PUBLIC_TURNSTILE_SITE_KEY}
              data-callback="onTurnstileSuccess"
              data-theme="light"
            >
            </div>
          </div>

          <div class="form-feedback" aria-live="polite"></div>
          <button type="submit" id="gi-submit-btn" class="submit-btn"
            >Send Message</button
          >
          <p class="privacy-notice">
            &#128274; Your message is sent via a secure connection
          </p>
        </form>
      </div>
    </div>
  </section>

  <div class="logo-divider" aria-hidden="true">
    <div class="divider-line"></div>
    <div class="divider-logo">
      <img src="/images/favicon.ico" alt="" />
    </div>
    <div class="divider-line"></div>
  </div>

  <section class="contact-info" id="contact-info">
    <div class="contact-info-container">
      <div class="info-card">
        <h3>Contact Info</h3>
        <div class="info-content">
          <p class="contact-item">
            <i class="fas fa-map-marker-alt" aria-hidden="true"></i>
            <span>
              <strong>Gender Dynamix of <span lang="mi">Aotearoa</span></strong
              ><br />
              Building 55, Historic Village <br />
              17th Avenue, Tauranga
            </span>
          </p>

          <p class="contact-item">
            <i class="fas fa-phone" aria-hidden="true"></i>
            <a href="tel:075482972">07 548 2972</a>
          </p>

          <p class="contact-item">
            <i class="fas fa-envelope" aria-hidden="true"></i>
            <a
              href="#"
              class="email-link"
              data-user="referrals"
              data-domain="gdnz.org">Email Us</a
            >
          </p>

          <div class="social-icons-contact">
            <a
              href="https://www.instagram.com/genderdynamixnz/"
              target="_blank"
              rel="noopener noreferrer"
              aria-label="Instagram"
            >
              <i class="fab fa-instagram" aria-hidden="true"></i>
            </a>
            <a
              href="https://www.facebook.com/genderdynamixnz/"
              target="_blank"
              rel="noopener noreferrer"
              aria-label="Facebook"
              ><i class="fab fa-facebook-f" aria-hidden="true"></i></a
            >
            <a
              href="#"
              class="email-link"
              data-user="referrals"
              data-domain="gdnz.org"
              aria-label="Email"
            >
              <i class="fas fa-envelope" aria-hidden="true"></i>
            </a>
          </div>
        </div>
      </div>

      <div class="info-card">
        <h3>Office Hours</h3>
        <div class="info-content">
          <p><strong>11:00am — 5:00pm Mon-Fri</strong></p>
          <p>Closed: Saturday-Sunday</p>
          <p class="hours-note">
            We're closed on all national and public holidays. For urgent matters
            outside our hours, please email and we'll respond as soon as
            possible.
          </p>
        </div>
      </div>

      <div class="location-card">
        <div class="location-header">
          <div class="location-icon">
            <i class="fas fa-map-marker-alt" aria-hidden="true"></i>
          </div>
          <h3>Location</h3>
        </div>
        <div class="map-container">
          <div class="map-embed">
            <iframe
              src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3156.6481250046245!2d176.14620917730463!3d-37.70446207200315!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x6d6dda4a159ecd97%3A0xa548d89a6ea2c131!2sThe%20Historic%20Village!5e0!3m2!1sen!2snz!4v1770680270680!5m2!1sen!2snz"
              width="600"
              height="450"
              style="border: 0"
              allowfullscreen=""
              loading="lazy"
              referrerpolicy="no-referrer-when-downgrade"
              title="Gender Dynamix office location at The Historic Village, Tauranga"
            ></iframe>
          </div>
        </div>

        <div class="detailed-map-card">
          <h4>Finding building 55</h4>
          <p>
            We're located in Building 55 within the Historic Village. Use this
            map to find us once you arrive:
          </p>
          <img
            src="/images/map.jpg"
            alt="Map displaying location of Building 55 within the historic village"
          />
          <div class="map-note">
            <p>
              <i class="fas fa-parking" aria-hidden="true"></i>
              <strong>Parking:</strong> Free parking available on Seventeenth Avenue.
            </p>
            <p>
              <i class="fas fa-walking" aria-hidden="true"></i>
              <strong>Access:</strong> Enter via pedestrian walkway near main entrance.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>
  <script src="../scripts/form-handler.ts"></script>
</BaseLayout>

<script is:inline>
  (function () {
    function toggleAccordion(header) {
      var content = header.nextElementSibling;
      var icon = header.querySelector('.accordion-toggle i');
      content.classList.toggle('collapsed');
      if (content.classList.contains('collapsed')) {
        icon.classList.replace('fa-arrow-up', 'fa-arrow-down');
        header
          .querySelector('.accordion-toggle')
          .setAttribute('aria-expanded', 'false');
      } else {
        icon.classList.replace('fa-arrow-down', 'fa-arrow-up');
        header
          .querySelector('.accordion-toggle')
          .setAttribute('aria-expanded', 'true');
      }
    }

    var accordionHeaders = document.querySelectorAll('.js-accordion-header');
    accordionHeaders.forEach(function (header) {
      header.addEventListener('click', function () {
        toggleAccordion(header);
      });
      header.style.cursor = 'pointer';
    });
  })();
</script>

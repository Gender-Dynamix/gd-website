---
import BaseLayout from '../layouts/BaseLayout.astro';
import WaveDivider from '../components/WaveDivider.astro';
import '../styles/services.css';
import '../styles/events.css';
---

<BaseLayout
  title="Our Services | Gender Dynamix Aotearoa"
  description="Explore our gender-diverse services in Tauranga: individual advocacy, peer support groups, and professional diversity training for organisations and schools."
  ogTitle="Gender-Diverse Support Services | Gender Dynamix Aotearoa"
  ogDescription="From individual advocacy to community groups—see how we support the transgender and gender-diverse community."
>
  <section class="hero">
    <div class="hero-bg-container">
      <img src="/images/hero-pattern-bg.webp" alt="" class="hero-bg-img" />
    </div>
    <div class="hero-content">
      <h1>Our Services</h1>
      <p>
        At Gender Dynamix we offer a range of services and resources tailored to
        the needs of our gender expansive <span lang="mi">whānau</span>.<br />
        We are committed to fostering a welcoming community where you can explore,
        grow, and connect on your journey towards self-discovery and empowerment.
      </p>
    </div>
    <WaveDivider
      direction="down"
      fillVar="--wave-top-color"
      className="custom-shape-divider-top"
    />
  </section>

  <!--Therapy-->
  <section class="service-detail" id="Therapy">
    <div class="service-detail-container">
      <div class="service-header js-accordion-header">
        <div class="service-title-group">
          <div class="service-icon-small" aria-hidden="true">
            <img src="/images/icons-01.webp" alt="Clinical Support Icon" />
          </div>
          <h2>Therapy</h2>
        </div>
        <button
          class="accordion-toggle"
          aria-label="Toggle section"
          aria-expanded="true"
        >
          <i class="fas fa-arrow-up" aria-hidden="true"></i>
        </button>
      </div>

      <div class="service-content">
        <p class="service-description">
          Gender expansive people come to therapy for all kinds of reasons, some
          of which are explicitly transition related and some that may have more
          to do with navigating day-to-day anti-trans bias. If you're struggling
          with low mood, isolation, anxiety, or minority stress, we can help.
          Most of the time people begin therapy with us after seeing a Peer
          Support worker for a needs assessment, but you are also welcome to
          contact <a href="mailto:clinical@gdnz.org">clinical@gdnz.org</a>
        </p>
      </div>
    </div>
  </section>

  <!--Peer Support-->
  <section class="service-detail" id="peer-support">
    <div class="service-detail-container">
      <div class="service-header js-accordion-header">
        <div class="service-title-group">
          <div class="service-icon-small">
            <img src="/images/icons-02.webp" alt="Peer Support Icon" />
          </div>
          <h2>Peer Support</h2>
        </div>
        <button
          class="accordion-toggle"
          aria-label="Toggle section"
          aria-expanded="true"
        >
          <i class="fas fa-arrow-up" aria-hidden="true"></i>
        </button>
      </div>

      <div class="service-content">
        <p class="service-description">
          Most of the people who come to Gender Dynamix start with Peer Support.
          Peer Support workers have lived experience of transition, so you can
          talk with someone who has been there. Peer support workers walk
          shoulder to shoulder with you, and can help with things like name
          change paperwork, building a new wardrobe or advocating with your GP.
          You do not have to give a legal name or identifying information to
          work with Peer Support.
        </p>

        <p>
          Ready to get started? Contact us at <a
            href="mailto:referrals@gdnz.org">referrals@gdnz.org</a
          >
        </p>
      </div>
    </div>
  </section>

  <!--Group Support Services-->
  <section class="service-detail" id="group-support">
    <div class="service-detail-container">
      <div class="service-header js-accordion-header">
        <div class="service-title-group">
          <div class="service-icon-small" aria-hidden="true">
            <img src="/images/icons-03.webp" alt="Group Support Icon" />
          </div>
          <h2>Groups</h2>
        </div>
        <button
          class="accordion-toggle"
          aria-label="Toggle section"
          aria-expanded="true"
        >
          <i class="fas fa-arrow-up" aria-hidden="true"></i>
        </button>
      </div>

      <div class="service-content">
        <p class="service-description">
          We offer a wide range of groups in Tauranga, Whakatāne, and online.
          Some of them are considered social groups, which means they are
          facilitated by Peer Support workers. Any gender expansive person is
          welcome to drop by any (age-appropriate) social group. Some groups are
          clinical groups. These are facilitated by a clinician, often have a
          specific focus, and have a formal intake process. Check the calendar
          for more details, or email <a href="mailto:groups@gdnz.org"
            >groups@gdnz.org</a
          >
          <br /><br />
          Dungeons and Dragons (and other TTRPGs) are in a league of their own! Because
          campaigns have cycles, you do have to register interest in advance and commit
          to a campaign in order to start. To register interest, or for more details,
          email <a href="mailto:DandD@gdnz.org">DandD@gdnz.org</a>
        </p>
      </div>
    </div>
  </section>

  <!--HRT-->
  <section class="service-detail" id="HRT">
    <div class="service-detail-container">
      <div class="service-header js-accordion-header">
        <div class="service-title-group">
          <div class="service-icon-small" aria-hidden="true">
            <div class="icon-circle-bg">
              <i class="fa-solid fa-plus" aria-hidden="true"></i>
            </div>
          </div>
          <h2>Gender Affirming Hormone Pathways for Adults</h2>
        </div>
        <button
          class="accordion-toggle"
          aria-label="Toggle section"
          aria-expanded="true"
        >
          <i class="fas fa-arrow-up" aria-hidden="true"></i>
        </button>
      </div>

      <div class="service-content">
        <p class="service-description">
          Gender Dynamix is, first and foremost, a mental health and social
          support service. And, many of our service users need gender affirming
          hormone therapy (GAHT) in order to thrive. While we ultimately don’t
          have much say in whether or not you can access GAHT, we have walked
          with many people down this pathway, and here are the steps we
          recommend for adults.
        </p>

        <ol>
          <li>
            Talk with your GP. All GPs can initiate and continue hormones on the
            informed consent model. Some don’t know that they can, while others
            choose not to. The model of GAHT care in the Bay of Plenty is moving
            toward a Primary Health Care model, and you will need a GP who is
            comfortable continuing your prescriptions even if they won’t
            initiate your prescription. If you don’t have a GP currently, we can
            recommend some who are gender affirming. A Peer Support worker can
            also accompany you to your appointment if you’d like, and can
            advocate on your behalf (or simply support you in self-advocacy).
            <br />
            <br />
            Questions to ask your doctor (or nurse prescriber) might include:
            <ul>
              <li>Would you consider initiating GAHT for me?</li>
              <li>
                Would you consider initiating GAHT for me if you had additional
                support?
              </li>
              <li>
                If I were to initiate GAHT elsewhere, would you be comfortable
                continuing my prescription?
              </li>
            </ul>
          </li>
          <li>
            If your GP is open to prescribing based on the informed consent
            model, congratulations! You’re about to get some bloodwork done, and
            are very likely to start on GAHT quite quickly.
          </li>
          <li>
            If your GP is potentially open to prescribing but needs additional
            support, they can contact us on referrals@gdnz.org, and we can put
            them in touch with a prescriber network. You can also contact us and
            ask us to get in touch with them.
          </li>
          <li>
            If your GP is not open to initiating, but is open to continuing a
            prescription you start elsewhere, make an appointment to see a Peer
            Support worker at Gender Dynamix. We will talk through options for
            next steps with you.
          </li>
          <li>
            If your GP is not open to managing your GAHT at all, we can help you
            find a new GP. Whether you start GAHT with them or through one of
            our other pathways, you’ll need to have a GP who is comfortable
            continuing your prescription and helping you navigate the other
            parts of your primary care.
          </li>
        </ol>
        <p>
          <!--service description -->
          If you are under 18, or acting on behalf of someone under 18, we recommend
          you contact us first, as these pathways can be somewhat more constricted.
        </p>
      </div>
    </div>
  </section>

  <!-- Training Form Section -->
  <section class="service-detail" id="training">
    <div class="service-detail-container">
      <div class="service-header js-accordion-header">
        <div class="service-title-group">
          <div class="service-icon-small" aria-hidden="true">
            <div class="icon-circle-bg">
              <img src="/images/work_icon.svg" alt="Training Icon" />
            </div>
          </div>
          <h2>Trainings</h2>
        </div>
        <button
          class="accordion-toggle"
          aria-label="Toggle section"
          aria-expanded="true"
        >
          <i class="fas fa-arrow-up" aria-hidden="true"></i>
        </button>
      </div>

      <div class="service-content">
        <p class="service-description">
          We work with social support agencies, doctor’s offices, and other
          mental health services providers to expand competency in providing
          gender affirming care. For more information, contact <a
            href="mailto:trainings@gdnz.org">trainings@gdnz.org</a
          >
        </p>
      </div>
    </div>
  </section>

  <!-- FAQ Section -->
  <section class="service-detail" id="faq">
    <div class="service-detail-container">
      <div class="service-header js-accordian-header">
        <div class="service-title-group">
          <div class="service-icon-small">
            <div class="icon-circle-bg">
              <i class="fa-solid fa-circle-question" aria-hidden="true"></i>
            </div>
          </div>
          <h2>Frequently Asked Questions</h2>
        </div>
        <button
          class="accordion-toggle"
          aria-label="Toggle section"
          aria-expanded="true"
        >
          <i class="fas fa-arrow-up" aria-hidden="true"></i>
        </button>
      </div>

      <div class="service-content">
        <div class="service-categories">
          <!-- Question 1 Removed-->
          <!-- Question 2 -->
          <div class="category-card">
            <h3>What is a peer support worker?</h3>
            <p>
              Our Peer support workers all have lived experience with
              transition. They are not clinicians — they use Intentional Peer
              Support model and must complete an NCEA Level 4 qualification or
              higher within their first two years of employment at Gender
              Dynamix.
            </p>
          </div>

          <!-- Question 3 -->
          <div class="category-card">
            <h3>Do I need to RSVP to come to a group?</h3>
            <p>
              No. You are welcome to come to any group that fits your age range,
              provided that you can uphold our group expectations. If you have
              any questions about a group, please contact us and have a read
              through the information on our website.
            </p>
          </div>

          <!-- Question 4 -->
          <div class="category-card">
            <h3>How much are appointments?</h3>
            <p>
              We are not Non-Profit Organisation and all our services are
              completely free.
            </p>
          </div>

          <!-- Question 5 -->
          <div class="category-card">
            <h3>
              Is there support for family/<span lang="mi">whānau</span>
            </h3>
            <p>
              We are happy to see parents and/or families for one-off individual
              sessions.
            </p>
          </div>

          <!-- Question 6 -->
          <div class="category-card wide-card">
            <h3>
              <i
                class="fa-solid fa-map-location-dot"
                style="margin-right: 8px;"
                aria-hidden="true"></i> Where is the office located?
            </h3>
            <p>
              Our office is situated near the back of <strong
                >The Historic Village</strong
              > (bottom of 17th Ave), Tauranga. When you enter The Village, walk straight
              down the main pedestrian walkway. Cross the street at the end of the
              cobblestones and look for our flags — we are next to the chapel. A large
              map is available just inside the entrance, or check the maps at the
              bottom of our
              <a href="/contact" class="event-link">Contact page</a>.
            </p>
          </div>
        </div>

        <p class="field-note">
          Please <a href="/contact">call or email us</a> if you have any other questions.
        </p>
      </div>
    </div>
  </section>

  <!-- Events Calendar -->
  <section class="service-detail" id="calendar">
    <div class="service-detail-container">
      <div class="service-header js-accordion-header">
        <div class="service-title-group">
          <div class="service-icon-small" aria-hidden="true">
            <div class="icon-circle-bg">
              <i class="fa-solid fa-calendar-days" aria-hidden="true"></i>
            </div>
          </div>
          <h2>Calendar</h2>
        </div>
        <button
          class="accordion-toggle"
          aria-label="Toggle section"
          aria-expanded="true"
        >
          <i class="fas fa-arrow-up" aria-hidden="true"></i>
        </button>
      </div>

      <div class="service-content">
        <div class="hub-selector">
          <p class="hub-label">Select your area:</p>
          <div class="hub-buttons">
            <button class="hub-btn active" data-hub="all" aria-pressed="true"
              >All Locations</button
            >
            <button class="hub-btn" data-hub="tauranga" aria-pressed="false"
              >Tauranga</button
            >
            <button class="hub-btn" data-hub="lakes" aria-pressed="false"
              >Lakes</button
            >
            <button class="hub-btn" data-hub="whakatane" aria-pressed="false"
              >Whakatāne</button
            >
            <button class="hub-btn" data-hub="online" aria-pressed="false"
              >Online</button
            >
          </div>
        </div>

        <div class="calendar-controls">
          <div class="month-nav">
            <button
              class="month-nav-btn"
              id="prev-month"
              aria-label="Previous month"
            >
              <i class="fa-solid fa-chevron-left" aria-hidden="true"></i>
            </button>
            <h3 id="current-month-label">Loading&hellip;</h3>
            <button
              class="month-nav-btn"
              id="next-month"
              aria-label="Next month"
            >
              <i class="fa-solid fa-chevron-right" aria-hidden="true"></i>
            </button>
          </div>
          <div
            class="tag-filters"
            id="tag-filters"
            role="group"
            aria-label="Filter events by type"
          >
          </div>
        </div>

        <div id="calendar-loading" class="calendar-loading" aria-live="polite">
          <div class="loading-spinner" aria-hidden="true"></div>
          <p>Loading events&hellip;</p>
        </div>

        <div id="calendar-error" class="calendar-error" hidden role="alert">
        </div>

        <div id="calendar-grid" class="calendar-grid" aria-live="polite" hidden>
        </div>

        <div
          id="event-detail-panel"
          class="event-detail-panel"
          hidden
          aria-live="polite"
        >
        </div>
      </div>
    </div>
  </section>

  <section class="cta-banner">
    <div class="cta-banner-container">
      <h2>Ready To Connect?</h2>
      <p>Reach out today to learn more about our services or book a referral</p>
      <a href="/contact" class="cta-button">Get In Touch</a>
    </div>
  </section>

  <script>
    const MONTH_NAMES = [
      'January',
      'February',
      'March',
      'April',
      'May',
      'June',
      'July',
      'August',
      'September',
      'October',
      'November',
      'December',
    ];
    const DAY_NAMES = ['Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat', 'Sun'];

    interface CalendarEvent {
      id: string;
      title: string;
      tags: string[];
      start: string;
      end: string;
      isAllDay: boolean;
      location: string | null;
      description: string | null;
      isRecurring: boolean;
      hub?: string;
    }

    const HUB_LABELS: Record<string, string> = {
      tauranga: 'Tauranga',
      lakes: 'Lakes',
      whakatane: 'Whakatāne',
      online: 'Online',
    };

    const TAG_LABELS: Record<string, string> = {
      social: 'Community Events',
      wi: 'Whānau Inclusive',
    };

    const state = {
      hub: 'all',
      year: new Date().getFullYear(),
      month: new Date().getMonth() + 1,
      activeTags: new Set<string>(),
      events: [] as CalendarEvent[],
      availableTags: [] as string[],
      selectedDay: null as string | null,
    };

    function escapeHtml(str: string): string {
      return str
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;')
        .replace(/'/g, '&#039;');
    }

    function formatTime(isoStr: string, isAllDay: boolean): string {
      if (isAllDay) return 'All day';
      try {
        return new Date(isoStr).toLocaleTimeString('en-NZ', {
          hour: 'numeric',
          minute: '2-digit',
          hour12: true,
          timeZone: 'Pacific/Auckland',
        });
      } catch {
        return '';
      }
    }

    function getFilteredEvents(): CalendarEvent[] {
      if (state.activeTags.size === 0) return state.events;
      return state.events.filter((e) =>
        e.tags.some((t) => state.activeTags.has(t)),
      );
    }

    function getEventsForDay(dateStr: string): CalendarEvent[] {
      return getFilteredEvents().filter(
        (e) => e.start.substring(0, 10) === dateStr,
      );
    }

    async function fetchEvents(): Promise<void> {
      const loadingEl = document.getElementById('calendar-loading')!;
      const errorEl = document.getElementById('calendar-error')!;
      const gridEl = document.getElementById('calendar-grid')!;

      loadingEl.hidden = false;
      gridEl.hidden = true;
      errorEl.hidden = true;

      try {
        const url = `/api/events.json?hub=${state.hub}&year=${state.year}&month=${state.month}`;
        const res = await fetch(url);
        if (!res.ok) throw new Error(`HTTP ${res.status}`);
        const data = await res.json();
        state.events = data.events as CalendarEvent[];
        state.availableTags = data.availableTags as string[];
        state.activeTags = new Set(
          [...state.activeTags].filter((t) => state.availableTags.includes(t)),
        );
      } catch {
        errorEl.textContent = 'Unable to load events. Please try again later.';
        errorEl.hidden = false;
        loadingEl.hidden = true;
        return;
      }

      loadingEl.hidden = true;
      gridEl.hidden = false;
      renderFilters();
      renderCalendar();
    }

    function renderFilters(): void {
      const container = document.getElementById('tag-filters')!;
      container.innerHTML = '';

      if (state.availableTags.length === 0) return;

      const allBtn = document.createElement('button');
      allBtn.className =
        'tag-chip' + (state.activeTags.size === 0 ? ' active' : '');
      allBtn.textContent = 'All events';
      allBtn.addEventListener('click', () => {
        state.activeTags.clear();
        renderFilters();
        renderCalendar();
        if (state.selectedDay) showDayDetail(state.selectedDay);
      });
      container.appendChild(allBtn);

      for (const tag of state.availableTags) {
        const btn = document.createElement('button');
        btn.className =
          'tag-chip' + (state.activeTags.has(tag) ? ' active' : '');
        btn.textContent =
          TAG_LABELS[tag] ?? tag.charAt(0).toUpperCase() + tag.slice(1);
        btn.addEventListener('click', () => {
          if (state.activeTags.has(tag)) {
            state.activeTags.delete(tag);
          } else {
            state.activeTags.add(tag);
          }
          renderFilters();
          renderCalendar();
          if (state.selectedDay) showDayDetail(state.selectedDay);
        });
        container.appendChild(btn);
      }
    }

    function renderCalendar(): void {
      const grid = document.getElementById('calendar-grid')!;
      grid.innerHTML = '';

      document.getElementById('current-month-label')!.textContent =
        `${MONTH_NAMES[state.month - 1]} ${state.year}`;

      for (const name of DAY_NAMES) {
        const header = document.createElement('div');
        header.className = 'calendar-day-header';
        header.textContent = name;
        grid.appendChild(header);
      }

      const firstDay = new Date(state.year, state.month - 1, 1);
      const lastDay = new Date(state.year, state.month, 0);
      const today = new Date();
      const todayStr = [
        today.getFullYear(),
        String(today.getMonth() + 1).padStart(2, '0'),
        String(today.getDate()).padStart(2, '0'),
      ].join('-');

      const startPadding = (firstDay.getDay() + 6) % 7;
      const prevMonthLastDay = new Date(
        state.year,
        state.month - 1,
        0,
      ).getDate();

      for (let i = startPadding - 1; i >= 0; i--) {
        const cell = document.createElement('div');
        cell.className = 'calendar-day other-month';
        cell.innerHTML = `<span class="day-number">${prevMonthLastDay - i}</span>`;
        grid.appendChild(cell);
      }

      for (let day = 1; day <= lastDay.getDate(); day++) {
        const dateStr = [
          state.year,
          String(state.month).padStart(2, '0'),
          String(day).padStart(2, '0'),
        ].join('-');

        const dayEvents = getEventsForDay(dateStr);
        const hasClosure = dayEvents.some((e) => e.tags.includes('closure'));
        const isToday = dateStr === todayStr;

        const cell = document.createElement('div');
        cell.className = [
          'calendar-day',
          hasClosure ? 'has-closure' : '',
          isToday ? 'today' : '',
          dayEvents.length > 0 ? 'has-events' : '',
        ]
          .filter(Boolean)
          .join(' ');

        const dayNum = document.createElement('span');
        dayNum.className = 'day-number';
        dayNum.textContent = String(day);
        cell.appendChild(dayNum);

        const maxPills = 3;
        for (const event of dayEvents.slice(0, maxPills)) {
          const pill = document.createElement('span');
          pill.className = [
            'event-pill',
            event.tags.includes('closure') ? 'closure' : '',
            event.isAllDay ? 'all-day' : '',
          ]
            .filter(Boolean)
            .join(' ');
          pill.textContent = event.title;
          pill.title = event.title;
          cell.appendChild(pill);
        }

        const overflow = dayEvents.length - maxPills;
        if (overflow > 0) {
          const more = document.createElement('span');
          more.className = 'event-pill more';
          more.textContent = `+${overflow} more`;
          cell.appendChild(more);
        }

        cell.addEventListener('click', () => {
          state.selectedDay = dateStr;
          document
            .querySelectorAll('.calendar-day')
            .forEach((c) => c.classList.remove('selected'));
          cell.classList.add('selected');
          showDayDetail(dateStr);
        });

        grid.appendChild(cell);
      }

      const totalCells = startPadding + lastDay.getDate();
      const endPadding = totalCells % 7 === 0 ? 0 : 7 - (totalCells % 7);
      for (let day = 1; day <= endPadding; day++) {
        const cell = document.createElement('div');
        cell.className = 'calendar-day other-month';
        cell.innerHTML = `<span class="day-number">${day}</span>`;
        grid.appendChild(cell);
      }
    }

    function showDayDetail(dateStr: string): void {
      const panel = document.getElementById('event-detail-panel')!;
      const dayEvents = getEventsForDay(dateStr);

      if (dayEvents.length === 0) {
        panel.hidden = true;
        return;
      }

      const [y, m, d] = dateStr.split('-').map(Number);
      const dateLabel = new Date(y, m - 1, d).toLocaleDateString('en-NZ', {
        weekday: 'long',
        day: 'numeric',
        month: 'long',
        year: 'numeric',
      });

      let html = `<h3 class="detail-date">${dateLabel}</h3><ul class="detail-event-list">`;

      for (const event of dayEvents) {
        const startTime = formatTime(event.start, event.isAllDay);
        const endTime =
          event.isAllDay || !event.end
            ? ''
            : ` – ${formatTime(event.end, false)}`;

        const tagBadges = event.tags
          .map(
            (t) =>
              `<span class="detail-tag detail-tag--${escapeHtml(t)}">${escapeHtml(t)}</span>`,
          )
          .join('');

        const hubBadge =
          event.hub && state.hub === 'all'
            ? `<span class="detail-hub">${escapeHtml(HUB_LABELS[event.hub] ?? event.hub)}</span>`
            : '';

        html += `
        <li class="detail-event${event.tags.includes('closure') ? ' detail-event--closure' : ''}">
          <div class="detail-event-header">
            <span class="detail-time">${startTime}${endTime}</span>
            <div class="detail-tags">${hubBadge}${tagBadges}</div>
          </div>
          <strong class="detail-title">${escapeHtml(event.title)}</strong>
          ${event.location ? `<p class="detail-location"><i class="fa-solid fa-location-dot" aria-hidden="true"></i> ${escapeHtml(event.location)}</p>` : ''}
          ${event.description ? `<div class="detail-description">${event.description}</div>` : ''}
          ${event.isRecurring ? '<p class="detail-recurring"><i class="fa-solid fa-rotate" aria-hidden="true"></i> Recurring event</p>' : ''}
        </li>`;
      }

      html += '</ul>';
      panel.innerHTML = html;
      panel.hidden = false;
      panel.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
    }

    document.getElementById('prev-month')!.addEventListener('click', () => {
      if (state.month === 1) {
        state.month = 12;
        state.year--;
      } else {
        state.month--;
      }
      state.selectedDay = null;
      document.getElementById('event-detail-panel')!.hidden = true;
      fetchEvents();
    });

    document.getElementById('next-month')!.addEventListener('click', () => {
      if (state.month === 12) {
        state.month = 1;
        state.year++;
      } else {
        state.month++;
      }
      state.selectedDay = null;
      document.getElementById('event-detail-panel')!.hidden = true;
      fetchEvents();
    });

    document.querySelectorAll<HTMLButtonElement>('.hub-btn').forEach((btn) => {
      btn.addEventListener('click', () => {
        const hub = btn.dataset.hub;
        if (!hub || hub === state.hub) return;
        state.hub = hub;
        state.selectedDay = null;
        state.activeTags.clear();
        document.getElementById('event-detail-panel')!.hidden = true;
        document.querySelectorAll('.hub-btn').forEach((b) => {
          b.classList.toggle('active', b === btn);
          b.setAttribute('aria-pressed', b === btn ? 'true' : 'false');
        });
        fetchEvents();
      });
    });

    fetchEvents();
  </script>

  <script is:inline>
    // Accordian Toggle Logic
    (function () {
      function toggleAccordion(header) {
        var content = header.nextElementSibling;
        var icon = header.querySelector('.accordion-toggle i');
        content.classList.toggle('collapsed');
        if (content.classList.contains('collapsed')) {
          icon.classList.replace('fa-arrow-up', 'fa-arrow-down');
          header
            .querySelector('.accordion-toggle')
            .setAttribute('aria-expanded', 'false');
        } else {
          icon.classList.replace('fa-arrow-down', 'fa-arrow-up');
          header
            .querySelector('.accordion-toggle')
            .setAttribute('aria-expanded', 'true');
        }
      }

      var accordionHeaders = document.querySelectorAll('.js-accordion-header');
      accordionHeaders.forEach(function (header) {
        header.addEventListener('click', function () {
          toggleAccordion(header);
        });
        header.style.cursor = 'pointer';
      });
    })();

    // Event Date Calculations
    function initUpcomingDates() {
      const dayNames = [
        'Sunday',
        'Monday',
        'Tuesday',
        'Wednesday',
        'Thursday',
        'Friday',
        'Saturday',
      ];

      document.querySelectorAll('.js-upcoming-date').forEach((el) => {
        const rule = el.dataset.rule;
        if (!rule) return;

        const [occurrence, dayName] = rule.split('-');
        const targetDay = dayNames.indexOf(dayName);
        const now = new Date();

        let meetingDate = calculateMeeting(
          now.getFullYear(),
          now.getMonth(),
          occurrence,
          targetDay,
        );

        if (meetingDate < now.setHours(0, 0, 0, 0)) {
          meetingDate = calculateMeeting(
            now.getFullYear(),
            now.getMonth() + 1,
            occurrence,
            targetDay,
          );
        }

        el.textContent = `— Next: ${meetingDate.toLocaleDateString('en-NZ', { day: 'numeric', month: 'short' })}`;
        el.style.fontWeight = 'bold';
        el.style.visibility = 'visible';
      });

      function calculateMeeting(year, month, occ, dayIdx) {
        if (occ === 'L') {
          let d = new Date(year, month + 1, 0);
          while (d.getDay() !== dayIdx) d.setDate(d.getDate() - 1);
          return d;
        } else {
          let d = new Date(year, month, 1);
          while (d.getDay() !== dayIdx) d.setDate(d.getDate() + 1);
          d.setDate(d.getDate() + (parseInt(occ) - 1) * 7);
          return d;
        }
      }
    }

    initUpcomingDates();
    document.addEventListener('astro:after-swap', initUpcomingDates);
  </script>
</BaseLayout>

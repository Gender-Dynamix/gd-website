            <li>Item 2</li>
            <li>Item 3</li>
          </ul>
        </div>

        <h3>Interested in Training?</h3>
        <p class="form-subtitle">
          Book a Training Session<br />Organisations/Schools
        </p>
        <form data-form-type="training" novalidate>
          <input type="hidden" name="form-type" value="training" />
          <div class="visually-hidden" aria-hidden="true">
            <input
              type="text"
              name="website"
              tabindex="-1"
              autocomplete="off"
            />
          </div>
          <div class="form-group">
            <label for="contact-name">Contact Name:*</label>
            <input
              type="text"
              id="contact-name"
              name="contact-name"
              required
              aria-describedby="name-error"
            />
            <span id="name-error" class="validation-message"
              >Please enter the name of the primary contact for this training.</span
            >
          </div>

          <div class="form-group">
            <label for="email">Email:*</label>
            <input
              type="email"
              id="email"
              name="email"
              required
              aria-describedby="email-error"
            />
            <span id="email-error" class="validation-message"
              >Please enter a valid email address for training correspondence.</span
            >
          </div>

          <div class="form-group">
            <label for="contact-phone">Contact Phone:*</label>
            <input
              type="tel"
              id="contact-phone"
              name="contact-phone"
              required
              aria-describedby="phone-error"
            />
            <span id="phone-error" class="validation-message"

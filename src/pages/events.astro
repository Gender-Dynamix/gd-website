---
import BaseLayout from '../layouts/BaseLayout.astro';
import WaveDivider from '../components/WaveDivider.astro';
import '../styles/events.css';
---

<BaseLayout
  title="Events | Gender Dynamix Aotearoa"
  description="Stay up to date with events at Gender Dynamix Aotearoa — weekly peer support groups, special community events, and more."
  ogTitle="Events | Gender Dynamix Aotearoa"
  ogDescription="Find upcoming events for the transgender and gender-diverse community in the Bay of Plenty."
>
  <section class="hero">
    <div class="hero-bg-container">
      <img src="/images/hero-pattern-bg.webp" alt="" class="hero-bg-img" />
    </div>
    <div class="hero-content">
      <h1>Events</h1>
      <p>
        Find out what's on at Gender Dynamix Aotearoa — from weekly peer support
        groups to special community events. Select your area and filter by event
        type to see what's happening near you.
      </p>
    </div>
    <WaveDivider
      direction="down"
      fillVar="--wave-top-color"
      className="custom-shape-divider-top"
    />
  </section>

  <section class="events-section">
    <div class="events-container">
      <div class="hub-selector">
        <p class="hub-label">Select your area:</p>
        <div class="hub-buttons">
          <button class="hub-btn active" data-hub="tauranga" aria-pressed="true"
            >Tauranga</button
          >
        </div>
      </div>

      <div class="calendar-controls">
        <div class="month-nav">
          <button
            class="month-nav-btn"
            id="prev-month"
            aria-label="Previous month"
          >
            <i class="fa-solid fa-chevron-left" aria-hidden="true"></i>
          </button>
          <h2 id="current-month-label">Loading&hellip;</h2>
          <button class="month-nav-btn" id="next-month" aria-label="Next month">
            <i class="fa-solid fa-chevron-right" aria-hidden="true"></i>
          </button>
        </div>
        <div
          class="tag-filters"
          id="tag-filters"
          role="group"
          aria-label="Filter events by type"
        >
        </div>
      </div>

      <div id="calendar-loading" class="calendar-loading" aria-live="polite">
        <div class="loading-spinner" aria-hidden="true"></div>
        <p>Loading events&hellip;</p>
      </div>

      <div id="calendar-error" class="calendar-error" hidden role="alert"></div>

      <div id="calendar-grid" class="calendar-grid" aria-live="polite" hidden>
      </div>

      <div
        id="event-detail-panel"
        class="event-detail-panel"
        hidden
        aria-live="polite"
      >
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  const MONTH_NAMES = [
    'January',
    'February',
    'March',
    'April',
    'May',
    'June',
    'July',
    'August',
    'September',
    'October',
    'November',
    'December',
  ];
  const DAY_NAMES = ['Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat', 'Sun'];

  interface CalendarEvent {
    id: string;
    title: string;
    tags: string[];
    start: string;
    end: string;
    isAllDay: boolean;
    location: string | null;
    description: string | null;
    isRecurring: boolean;
  }

  const state = {
    hub: 'tauranga',
    year: new Date().getFullYear(),
    month: new Date().getMonth() + 1,
    activeTags: new Set<string>(),
    events: [] as CalendarEvent[],
    availableTags: [] as string[],
    selectedDay: null as string | null,
  };

  // ── Helpers ──────────────────────────────────────────────────────────────────

  function escapeHtml(str: string): string {
    return str
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;')
      .replace(/'/g, '&#039;');
  }

  function formatTime(isoStr: string, isAllDay: boolean): string {
    if (isAllDay) return 'All day';
    try {
      return new Date(isoStr).toLocaleTimeString('en-NZ', {
        hour: 'numeric',
        minute: '2-digit',
        hour12: true,
        timeZone: 'Pacific/Auckland',
      });
    } catch {
      return '';
    }
  }

  function getFilteredEvents(): CalendarEvent[] {
    if (state.activeTags.size === 0) return state.events;
    return state.events.filter((e) =>
      e.tags.some((t) => state.activeTags.has(t)),
    );
  }

  function getEventsForDay(dateStr: string): CalendarEvent[] {
    return getFilteredEvents().filter(
      (e) => e.start.substring(0, 10) === dateStr,
    );
  }

  // ── Fetch ─────────────────────────────────────────────────────────────────────

  async function fetchEvents(): Promise<void> {
    const loadingEl = document.getElementById('calendar-loading')!;
    const errorEl = document.getElementById('calendar-error')!;
    const gridEl = document.getElementById('calendar-grid')!;

    loadingEl.hidden = false;
    gridEl.hidden = true;
    errorEl.hidden = true;

    try {
      const url = `/api/events.json?hub=${state.hub}&year=${state.year}&month=${state.month}`;
      const res = await fetch(url);
      if (!res.ok) throw new Error(`HTTP ${res.status}`);
      const data = await res.json();
      state.events = data.events as CalendarEvent[];
      state.availableTags = data.availableTags as string[];
      // Drop any active tag filters that no longer exist in this month's events
      state.activeTags = new Set(
        [...state.activeTags].filter((t) => state.availableTags.includes(t)),
      );
    } catch {
      errorEl.textContent = 'Unable to load events. Please try again later.';
      errorEl.hidden = false;
      loadingEl.hidden = true;
      return;
    }

    loadingEl.hidden = true;
    gridEl.hidden = false;
    renderFilters();
    renderCalendar();
  }

  // ── Render: filters ──────────────────────────────────────────────────────────

  function renderFilters(): void {
    const container = document.getElementById('tag-filters')!;
    container.innerHTML = '';

    if (state.availableTags.length === 0) return;

    const allBtn = document.createElement('button');
    allBtn.className =
      'tag-chip' + (state.activeTags.size === 0 ? ' active' : '');
    allBtn.textContent = 'All events';
    allBtn.addEventListener('click', () => {
      state.activeTags.clear();
      renderFilters();
      renderCalendar();
      if (state.selectedDay) showDayDetail(state.selectedDay);
    });
    container.appendChild(allBtn);

    for (const tag of state.availableTags) {
      const btn = document.createElement('button');
      btn.className = 'tag-chip' + (state.activeTags.has(tag) ? ' active' : '');
      btn.textContent = tag.charAt(0).toUpperCase() + tag.slice(1);
      btn.addEventListener('click', () => {
        if (state.activeTags.has(tag)) {
          state.activeTags.delete(tag);
        } else {
          state.activeTags.add(tag);
        }
        renderFilters();
        renderCalendar();
        if (state.selectedDay) showDayDetail(state.selectedDay);
      });
      container.appendChild(btn);
    }
  }

  // ── Render: calendar grid ────────────────────────────────────────────────────

  function renderCalendar(): void {
    const grid = document.getElementById('calendar-grid')!;
    grid.innerHTML = '';

    document.getElementById('current-month-label')!.textContent =
      `${MONTH_NAMES[state.month - 1]} ${state.year}`;

    // Day headers (Mon–Sun for NZ week start)
    for (const name of DAY_NAMES) {
      const header = document.createElement('div');
      header.className = 'calendar-day-header';
      header.textContent = name;
      grid.appendChild(header);
    }

    const firstDay = new Date(state.year, state.month - 1, 1);
    const lastDay = new Date(state.year, state.month, 0);
    const today = new Date();
    const todayStr = [
      today.getFullYear(),
      String(today.getMonth() + 1).padStart(2, '0'),
      String(today.getDate()).padStart(2, '0'),
    ].join('-');

    // Monday-first padding: (getDay() + 6) % 7 — Sun=0 maps to 6, Mon=1 maps to 0
    const startPadding = (firstDay.getDay() + 6) % 7;
    const prevMonthLastDay = new Date(state.year, state.month - 1, 0).getDate();

    for (let i = startPadding - 1; i >= 0; i--) {
      const cell = document.createElement('div');
      cell.className = 'calendar-day other-month';
      cell.innerHTML = `<span class="day-number">${prevMonthLastDay - i}</span>`;
      grid.appendChild(cell);
    }

    // Current month days
    for (let day = 1; day <= lastDay.getDate(); day++) {
      const dateStr = [
        state.year,
        String(state.month).padStart(2, '0'),
        String(day).padStart(2, '0'),
      ].join('-');

      const dayEvents = getEventsForDay(dateStr);
      const hasClosure = dayEvents.some((e) => e.tags.includes('closure'));
      const isToday = dateStr === todayStr;

      const cell = document.createElement('div');
      cell.className = [
        'calendar-day',
        hasClosure ? 'has-closure' : '',
        isToday ? 'today' : '',
        dayEvents.length > 0 ? 'has-events' : '',
      ]
        .filter(Boolean)
        .join(' ');

      const dayNum = document.createElement('span');
      dayNum.className = 'day-number';
      dayNum.textContent = String(day);
      cell.appendChild(dayNum);

      const maxPills = 3;
      for (const event of dayEvents.slice(0, maxPills)) {
        const pill = document.createElement('span');
        pill.className = [
          'event-pill',
          event.tags.includes('closure') ? 'closure' : '',
          event.isAllDay ? 'all-day' : '',
        ]
          .filter(Boolean)
          .join(' ');
        pill.textContent = event.title;
        pill.title = event.title;
        cell.appendChild(pill);
      }

      const overflow = dayEvents.length - maxPills;
      if (overflow > 0) {
        const more = document.createElement('span');
        more.className = 'event-pill more';
        more.textContent = `+${overflow} more`;
        cell.appendChild(more);
      }

      cell.addEventListener('click', () => {
        state.selectedDay = dateStr;
        document
          .querySelectorAll('.calendar-day')
          .forEach((c) => c.classList.remove('selected'));
        cell.classList.add('selected');
        showDayDetail(dateStr);
      });

      grid.appendChild(cell);
    }

    // Trailing days from next month to complete the final row
    const totalCells = startPadding + lastDay.getDate();
    const endPadding = totalCells % 7 === 0 ? 0 : 7 - (totalCells % 7);
    for (let day = 1; day <= endPadding; day++) {
      const cell = document.createElement('div');
      cell.className = 'calendar-day other-month';
      cell.innerHTML = `<span class="day-number">${day}</span>`;
      grid.appendChild(cell);
    }
  }

  // ── Render: day detail panel ─────────────────────────────────────────────────

  function showDayDetail(dateStr: string): void {
    const panel = document.getElementById('event-detail-panel')!;
    const dayEvents = getEventsForDay(dateStr);

    if (dayEvents.length === 0) {
      panel.hidden = true;
      return;
    }

    // Parse dateStr as local noon to avoid any timezone-driven date shifts
    const [y, m, d] = dateStr.split('-').map(Number);
    const dateLabel = new Date(y, m - 1, d).toLocaleDateString('en-NZ', {
      weekday: 'long',
      day: 'numeric',
      month: 'long',
      year: 'numeric',
    });

    let html = `<h3 class="detail-date">${dateLabel}</h3><ul class="detail-event-list">`;

    for (const event of dayEvents) {
      const startTime = formatTime(event.start, event.isAllDay);
      const endTime =
        event.isAllDay || !event.end
          ? ''
          : ` – ${formatTime(event.end, false)}`;

      const tagBadges = event.tags
        .map(
          (t) =>
            `<span class="detail-tag detail-tag--${escapeHtml(t)}">${escapeHtml(t)}</span>`,
        )
        .join('');

      html += `
        <li class="detail-event${event.tags.includes('closure') ? ' detail-event--closure' : ''}">
          <div class="detail-event-header">
            <span class="detail-time">${startTime}${endTime}</span>
            <div class="detail-tags">${tagBadges}</div>
          </div>
          <strong class="detail-title">${escapeHtml(event.title)}</strong>
          ${event.location ? `<p class="detail-location"><i class="fa-solid fa-location-dot" aria-hidden="true"></i> ${escapeHtml(event.location)}</p>` : ''}
          ${event.description ? `<div class="detail-description">${event.description}</div>` : ''}
          ${event.isRecurring ? '<p class="detail-recurring"><i class="fa-solid fa-rotate" aria-hidden="true"></i> Recurring event</p>' : ''}
        </li>`;
    }

    html += '</ul>';
    panel.innerHTML = html;
    panel.hidden = false;
    panel.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
  }

  // ── Month navigation ─────────────────────────────────────────────────────────

  document.getElementById('prev-month')!.addEventListener('click', () => {
    if (state.month === 1) {
      state.month = 12;
      state.year--;
    } else {
      state.month--;
    }
    state.selectedDay = null;
    document.getElementById('event-detail-panel')!.hidden = true;
    fetchEvents();
  });

  document.getElementById('next-month')!.addEventListener('click', () => {
    if (state.month === 12) {
      state.month = 1;
      state.year++;
    } else {
      state.month++;
    }
    state.selectedDay = null;
    document.getElementById('event-detail-panel')!.hidden = true;
    fetchEvents();
  });

  // ── Hub selection ─────────────────────────────────────────────────────────────

  document.querySelectorAll<HTMLButtonElement>('.hub-btn').forEach((btn) => {
    btn.addEventListener('click', () => {
      const hub = btn.dataset.hub;
      if (!hub || hub === state.hub) return;
      state.hub = hub;
      state.selectedDay = null;
      state.activeTags.clear();
      document.getElementById('event-detail-panel')!.hidden = true;
      document.querySelectorAll('.hub-btn').forEach((b) => {
        b.classList.toggle('active', b === btn);
        b.setAttribute('aria-pressed', b === btn ? 'true' : 'false');
      });
      fetchEvents();
    });
  });

  // ── Initial load ──────────────────────────────────────────────────────────────

  fetchEvents();
</script>

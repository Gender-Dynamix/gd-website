            <i class="fa-solid fa-circle-play"></i>
          </div>
          <h3>Video Gallery</h3>
        </a>
      </div>
    </div>
  </section>

  <WaveDivider fill="#ad98c4" direction="up" />

  <section class="kiwi-organisations" id="kiwi-organisations">
    <div class="section-heading">
      <h2>Kiwi Organisations</h2>
      <p>
        Connect with transgender and gender diverse organisations across
        <span lang="mi">Aotearoa</span> New Zealand
      </p>
    </div>

    <!--Secondary Navigation for Organisation Resources -->
    <div class="org-subnav">
      {
        orgSections.map((s) => (
          <a href={`#${s.id}`} class={`org-subnav-pill accent-${s.accent}`}>
            <i class={`fas ${s.icon}`} aria-hidden="true" />
            {s.title}
          </a>
        ))
      }
    </div>
  </section>

  <!--Dynamic org category sections -->
  {
    orgSections.map((section) => (
      <section id={section.id} class={`org-section accent-${section.accent}`}>
        <div class="org-section-heading">
          <div class="heading-with-icon">
            <i class={`fas ${section.icon}`} aria-hidden="true" />
            <h2>{section.title}</h2>
          </div>
          <p>{section.description}</p>
        </div>

        <div class="org-container">
          <div class="org-cards-grid">
            {section.orgs.map((org) => (
              <div class="kiwi-card">
                <div class={`kiwi-img ${org.logoClass || ''}`}>
                  {/* Hiding the logo because the name is in the H3 right below.
                  This prevents the screen reader from saying the name twice.
                */}
                  <img src={org.logo} alt="" aria-hidden="true" />
                </div>

                <div class="kiwi-body">
                  <span class="kiwi-category">{org.tag}</span>

                  {/* Using set:html to render the <span> tags from our helper */}
                  <h3 set:html={wrapMaori(org.name)} />
                  <p set:html={wrapMaori(org.desc)} />

                  <a
                    href={org.url}
                    class="kiwi-link"
                    target="_blank"
                    rel="noopener noreferrer"
                    aria-label={`Visit ${org.name} website`}
                  >
                    Visit Website
                  </a>
                </div>
              </div>
            ))}
          </div>
        </div>
      </section>
    ))
  }

  <section class="partner-feature">
    <div class="section-heading partner-heading">
      <h2>Featured Partner - Transcend Garments</h2>

import AgeVerificationModal from '../components/AgeVerificationModal.astro';
import WaveDivider from '../components/WaveDivider.astro';
import '../styles/resources.css';

// Helper to wrap common Māori words found in your data
const wrapMaori = (text: string) => {
  const words = [
    'Aotearoa',
    'Takatāpui',
    'Kōaro',
    'Te Whatu Ora',
    'Whakawāhine',
  ];
  let formatted = text;

  words.forEach((word) => {
    const regex = new RegExp(`(${word})`, 'g');
    formatted = formatted.replace(regex, '<span lang="mi">$1</span>');
  });

  return formatted;
};


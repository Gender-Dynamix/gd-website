              rel="noopener noreferrer">Carmen Liu Lingerie</a
            >
          </li>
          <li>
            <a
              href="https://tuckandbind.com"
              target="_blank"
              rel="noopener noreferrer">Tuck & Bind</a
            >
          </li>
          <li>
            <a
              href="https://zhebykarynelizabeth.com/shop/"
              target="_blank"
              rel="noopener noreferrer">Zhe By Karyn Elizabeth</a
            >
          </li>
          <li>
            <a
              href="https://unclockable.com/"
              target="_blank"
              rel="noopener noreferrer">Unclockable</a
            >
          </li>
          <li>
            <a
              href="https://www.ftmessentials.com/"
              target="_blank"
              rel="noopener noreferrer">FTM Essentials</a
            >
          </li>
          <li>
            <a
              href="https://enfemmestyle.com"
              target="_blank"
              rel="noopener noreferrer">Enfemme</a
            >
          </li>
        </ul>
      </div>
    </div>
  </section>

  <section class="video-resources" id="video-resources">
    <div class="section-heading">
      <h2>Video Gallery</h2>
      <p>
        Educational videos to support your journey and expand your understanding
      </p>
    </div>

    <div class="video-cards-container">
      <div class="video-card">
        <div class="video-img">
          <img
            src="/images/organisation-logos/insideout-logo-transparent-550.png"
            alt="Video Resource"
          />
        </div>
        <div class="video-body">
          <span class="video-category">Educational Video</span>
          <h3>InsideOUT</h3>
          <p>
            Created by RainbowYOUTH and partners. This resource is curated for
            NZ education, it features a series of short episodes (Episodes 1-5)
            covering everything from "Gender, Sex & sexuality" to "Transgender &
            intersex identities". <br />
            Recommended for: Beginners, Teachers, Family members and youth
          </p>
          <a
            href="https://insideout.ry.org.nz/video-resources"
            class="video-link">Watch Videos!</a
          >
        </div>
      </div>

      <div class="video-card">
        <div class="video-img">
          <img
            src="/images/organisation-logos/healthify.webp"
            alt="Video Resource"
          />
        </div>
        <div class="video-body">
          <span class="video-category">Educational Video</span>
          <h3>Healthify Gender Diversity</h3>
          <p>
            This health portal hosts several short and practical videos
            including "What it's like to be intersex" and other personal stories
            like "Charly Walsh's Transgender Story". <br />
            Recommended for: A clinical yet empathetic overview of what gender dysphoria
            feels like and how it is treated in NZ.
          </p>
          <a
            href="https://healthify.nz/health-a-z/g/gender-diversity"
            class="video-link">Watch Videos!</a
          >
        </div>
      </div>
    </div>

    <!-- YouTube Embeds Section -->
    <div class="youtube-embeds-section">
      <div class="subsection-title">
        <h3>Featured Videos</h3>
      </div>

      <div class="youtube-embed-card">
        <div class="embed-container">
          <iframe
            src="https://www.youtube-nocookie.com/embed?listType=playlist&list=PL4lyxUW1_5XPUDoDD6HGWNZWYhe8O_FXA"
            title="YouTube video player"
            allow="autoplay; encrypted-media; picture-in-picture"
            allowfullscreen
          >
          </iframe>
        </div>
        <div class="embed-info">
          <span class="video-badge">Video Series</span>
          <h4>Te Ao Takat&#257;pui</h4>
          <p>
            A beautiful documentary series by InsideOUT K&#333;aro that shares
            the stories of Takat&#257;pui (M&#257;ori Rainbow) community
            members.
          </p>
          <p class="video-meta">
            <i class="fas fa-info-circle"></i>
            Recommended for: Understanding the intersection of culture, indigeneity,
            and gender identity in Aotearoa.
          </p>
        </div>
      </div>
    </div>
  </section>
  <!-- Featured Resource Highlight -->
  <div class="section-heading" id="downloads">
    <h2>Resource Library</h2>
    <p>
      Essential clinical guidelines, whānau support documents, and community
      education resources available for download. Supporting informed healthcare
      and empowered identities across New Zealand.
    </p>
  </div>
  <section class="featured-resource-section">
    <div class="featured-resource-container">
      <div class="featured-resource-card">
        <div class="featured-left">
          {
            featuredResource.image ? (
              <img
                src={featuredResource.image}
                alt={featuredResource.title}
                class="featured-cover-img"
              />
            ) : (
              <div class="pdf-placeholder featured-placeholder">
                <i class="fas fa-file-pdf pdf-icon-large" />
              </div>
            )
          }
        </div>

        <div class="featured-content">
          <div class="featured-badge-label">{featuredResource.badge}</div>
          <h2>{featuredResource.title}</h2>
          <p>{featuredResource.desc}</p>

          <div class="featured-meta">
            <span><i class="fas fa-file-pdf"></i> PDF</span>
            <span><i class="fas fa-hdd"></i> {featuredResource.size}</span>
          </div>

          <a
            href={`/pdfs/${featuredResource.file}`}
            class="featured-download-btn"
            download
          >
            Download Resource <i class="fa-solid fa-download"></i>
          </a>
        </div>
      </div>
    </div>
  </section>
  <!-- Resource Sections (Dynamic) -->
  {
    sections.map((section) => (
      <section id={section.id} class="resource-section">
        <div class="resource-section-heading">
          <div class="heading-with-icon">
            <i class={`fas ${section.icon}`} />
            <h2>{section.title}</h2>
          </div>
          <p>
            {section.id === 'provider-resources' &&
              'Clinical guidelines and protocols for healthcare professionals'}
            {section.id === 'whanau-resources' &&
              'Resources for Māori whānau and takatāpui communities'}
            {section.id === 'community-resources' &&
              'Educational materials for community members and allies'}
          </p>
        </div>

        <div class="resource-container">
          <div class="pdf-cards-grid">
            {section.data.map((pdf) => (
              <div class="pdf-card">
                <div class="pdf-thumbnail">
                  {pdf.image ? (
                    <img
                      src={pdf.image}
                      alt={pdf.title}
                      class="pdf-cover-img"
                    />
                  ) : (
                    <div class="pdf-icon-large">
                      <i class="fas fa-file-pdf" />
                    </div>
                  )}
                  <div class="pdf-badge">{pdf.date}</div>
                </div>

                <div class="pdf-content">
                  <h3>{pdf.title}</h3>
                  <p>{pdf.desc}</p>
                  <div class="pdf-meta">
                    <span>
                      <i class="fas fa-file-pdf" />
                      PDF
                    </span>
                    <span>
                      <i class="fas fa-hdd" />
                      {pdf.size}
                    </span>
                  </div>
                  <a
                    href={`/pdfs/${pdf.file}`}
                    class="pdf-download-btn"
                    download
                  >
                    Download PDF <i class="fa-solid fa-download" />
                  </a>
                </div>
              </div>
            ))}
          </div>
        </div>
      </section>
    ))
  }
</BaseLayout>
